<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Log In</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <nav id="top_bar">
    <div id="user_info">
      <p>
        <%= user.username %>
          <sup>
            <%= user.status %>
          </sup>
      </p>
    </div>
    <input type="text" name="search" id="search">
    <script>
      const searchInput = document.querySelector("#search");

      searchInput.addEventListener("keydown", (e) => {
        console.log(searchInput.value + e.key);
      })
    </script>
  </nav>
  <main id="posts">
    <% if (posts.length> 0)  (%>
      <% if (user.status !=="visitor") { %>
        <form class="new_post" method="POST" action="/posts">
          <input type="text" name="title" id="title">
          <input type="text" name="content" id="content">
          <button type="submit">Publish</button>
        </form>
      <% } %>
      <% posts.forEach(post=> { %>
        <article class="post" id="<%= post.id %>">
          <h4>
            <%= user.status !=="visitor" ? post.author.name : "Anonymous" %>
          </h4>
          <h4>
            <%= post.title %>
          </h4>
          <hr>
          <p>
            <%= post.content %>
          </p>
        </article>
      <% }) %>
    <% ) else ( %>
      <article class="post">No posts made.</article>
    <% ) %>
  </main>
  <a href="/log-out">LOG OUT</a>
</body>

</html>