<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Log In</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <header id="top_bar">
    <nav>
      <div id="user_info">
        <p>
          <%= user.username %>
          <sup><%= user.status %></sup>
        </p>
      </div>
      <form action="/posts" class="search">
        <button type="submit">search</button>
        <input type="text" name="query" id="query" value="<%= query ?? "" %>">
        <script>
          (() => {
            const form = document.querySelector("form.search");
            const input = document.querySelector("input.query");

            if (!input || !form) return;

            input.addEventListener("keypress", (e) => {
              if (e.key !== "Enter") return;

              form.submit();
            });

            form.addEventListener("submit", (e) => {
              if (input.value !== "") return;

              e.preventDefault();
            })
          })()
        </script>
      </form>
    </nav>
  </header>
  <main id="posts">
    <% if (user.status !== "visitor") { %>
      <form class="new_post" method="POST" action="/posts">
        <input type="text" name="title" id="title" placeholder="Post Title">
        <textarea 
          type="text" 
          name="content" 
          id="content" 
          placeholder="Post Content"
        >
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Ut culpa facere deleniti, sed corrupti sunt minus dolor illum repellendus magni quo nobis modi tempore vero hic quae nulla voluptate. Expedita.
        </textarea>
        <button type="submit">Publish</button>
      </form>
    <% } %>
    <% if (posts.length > 0) { %>
      <% posts.forEach(post=> { %>
        <article class="post" id="<%= post.id %>">
          <% if (user.status === "admin") { %>
            <form id="delete<%= post.id %>" action="/posts">
              <input type="text" name="id" id="<%= post.id %>" value="<%= post.id %>" readonly hidden>
              <button type="submit">Delete Post</button>
              <script>
                (() => {
                  let firstFetch = true;

                  const form = document.querySelector("form#delete<%= post.id %>");

                  if (!form) return;

                  form.addEventListener("submit", (e) => {
                    // e.preventDefault();

                    if (!firstFetch) return;

                    firstFetch = false;

                    const {origin, pathname} = location;

                    const url = `${origin}${pathname}?id=${e.target.id.value}`;

                    console.log(url);

                    fetch(url, { method: `DELETE` });
                  })
                })()
              </script>
            </form>
          <% } %>
          <div class="info">
            <h4 class="username"><%= 
              user.status !== "visitor" ? post.author_data.username : "Anonymous" 
            %></h4>
            <time 
              class="date" 
              datetime="<%= 
                (() => {
                  const targetUTCDate = post.created_at; 
                  let localDate = new Date(targetUTCDate);



                  localDate.setMinutes(targetUTCDate.getMinutes() - targetUTCDate.getTimezoneOffset());

                  return localDate;
                })().toISOString();
              %>"
            ><%= 
              (() => {
                const targetUTCDate = post.created_at; 
                let localDate = new Date(targetUTCDate);

                localDate.setMinutes(targetUTCDate.getMinutes() - targetUTCDate.getTimezoneOffset());

                return localDate;
              })().toLocaleString() 
            %></time>
          </div>
          <h4><%= 
            post.title 
          %></h4>
          <hr>
          <p><%= 
            post.content 
          %></p>
        </article>
      <% }) %>
    <% } else { %>
      <article class="post"><%= 
        query ? "No post matches query." : "No posts made."  
      %></article>
    <% } %>
  </main>
  <a href="/log-out">LOG OUT</a>
</body>

</html>