<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <title>Log In</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>
  <header id="top_bar">
    <nav>
      <div id="user_info">
        <p>
          <%= user.username %>
          <sup><%= user.status %></sup>
        </p>
      </div>
      <form action="/posts" class="search">
        <button type="submit">
          <!-- Uploaded to: SVG Repo, www.svgrepo.com, Generator: SVG Repo Mixer Tools -->
          <svg width="20px" height="20px" viewBox="0 0 76 76" xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" baseProfile="full" enable-background="new 0 0 76.00 76.00"
            xml:space="preserve">
            <path fill="#000000" fill-opacity="1" stroke-width="0.2" stroke-linejoin="round"
              d="M 42.5,22C 49.4036,22 55,27.5964 55,34.5C 55,41.4036 49.4036,47 42.5,47C 40.1356,47 37.9245,46.3435 36,45.2426L 26.9749,54.2678C 25.8033,55.4393 23.9038,55.4393 22.7322,54.2678C 21.5607,53.0962 21.5607,51.1967 22.7322,50.0251L 31.7971,40.961C 30.6565,39.0755 30,36.8644 30,34.5C 30,27.5964 35.5964,22 42.5,22 Z M 42.5,26C 37.8056,26 34,29.8056 34,34.5C 34,39.1944 37.8056,43 42.5,43C 47.1944,43 51,39.1944 51,34.5C 51,29.8056 47.1944,26 42.5,26 Z " />
          </svg>
        </button>
        <input name="query" id="query" value="<%= query ?? "" %>">
        <script>
          (() => {
            const form = document.querySelector("form.search");
            const input = document.querySelector("input.query");

            if (!input || !form) return;

            input.addEventListener("keypress", (e) => {
              if (e.key !== "Enter") return;

              form.submit();
            });

            form.addEventListener("submit", (e) => {
              if (input.value !== "") return;

              e.preventDefault();
            })
          })()
        </script>
      </form>
    </nav>
  </header>
  <main id="posts">
    <% if (user.status !== "visitor") { %>
      <form id="new_post" method="POST" action="/posts">
        <input name="title" id="title" placeholder="Post Title" required>
        <textarea 
          name="content" 
          id="content" 
          placeholder="Post Content"
          required
        ></textarea>
        <button type="submit">Publish</button>
      </form>
    <% } else { %>
      <form id="upgrade_membership">
        <h1>Want to become a member? Then tell us our secret!</h1>
        <div class="input">
          <input name="club_key" id="club_key" placeholder="Club Secret">
          <button type="submit">Send</button>
        </div>
        <script>
            (() => {
              let firstFetch = true;

              const form = document.querySelector("form#upgrade_membership");

              if (!form) return;

              form.addEventListener("submit", async (e) => {
                if (!firstFetch) return;

                firstFetch = false;

                const url = `${location.origin}/users`;

                const body = JSON.stringify({ club_key: e.target.club_key.value });

                const upgrade = await fetch(url, { 
                  method: "PUT", 
                  headers: { 'content-type': "application/json" },
                  body 
                });

                const upgradeOK = await upgrade.text();
              });
            })()
        </script>
      </form>
    <% } %>
    <% if (posts.length > 0) { %>
      <% posts.forEach(post=> { %>
        <article class="post" id="<%= post.id %>">
          <% if (user.status === "admin") { %>
            <form id="delete<%= post.id %>">
              <input name="id" id="<%= post.id %>" value="<%= post.id %>" readonly hidden>
              <button type="submit">Delete Post</button>
              <script>
                (() => {
                  let firstFetch = true;

                  const form = document.querySelector("form#delete<%= post.id %>");

                  if (!form) return;

                  form.addEventListener("submit", (e) => {
                    if (!firstFetch) return;

                    firstFetch = false;

                    const url = `${location.origin}/posts?id=${e.target.id.value}`;

                    fetch(url, { method: "DELETE" });
                  })
                })()
              </script>
            </form>
          <% } %>
          <div class="info">
            <h4 class="username"><%= 
              user.status !== "visitor" ? post.author_data.username : "Anonymous" 
            %></h4>
            <time 
              class="date" 
              datetime="<%= 
                (() => {
                  const targetUTCDate = post.created_at; 
                  let localDate = new Date(targetUTCDate);



                  localDate.setMinutes(targetUTCDate.getMinutes() - targetUTCDate.getTimezoneOffset());

                  return localDate;
                })().toISOString();
              %>"
            ><%= 
              (() => {
                const targetUTCDate = post.created_at; 
                let localDate = new Date(targetUTCDate);

                localDate.setMinutes(targetUTCDate.getMinutes() - targetUTCDate.getTimezoneOffset());

                return localDate;
              })().toLocaleString() 
            %></time>
          </div>
          <h4 class="title"><%= 
            post.title 
          %></h4>
          <hr>
          <p class="content"><%= 
            post.content 
          %></p>
        </article>
      <% }) %>
    <% } else { %>
      <article class="post"><%= 
        query ? "No post matches query." : "No posts made."  
      %></article>
    <% } %>
  </main>
  <a href="/log-out">LOG OUT</a>
</body>

</html>